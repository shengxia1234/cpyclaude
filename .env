# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
CPY_CLAUDE_HOST=127.0.0.1
CPY_CLAUDE_PORT=7437

# ── Logging ───────────────────────────────────────────────────
CPY_CLAUDE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
CPY_CLAUDE_LOG_FILE=~/.cpyClaude/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
CPY_CLAUDE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
CPY_CLAUDE_CONFIG=~/.cpyClaude/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# openai | anthropic
WHICH_API=anthropic

ANTHROPIC_API_KEY=sk-bc4a389546584300ac8f3bbc4435de48
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_LLM_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_LLM_MAX_STEPS=20

OPENAI_API_KEY=sk-bc4a389546584300ac8f3bbc4435de48
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_LLM_DEFAULT_MODEL=deepseek-flash
OPENAI_LLM_MAX_STEPS=20
