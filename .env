# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
CPY_CLAUDE_HOST=127.0.0.1
CPY_CLAUDE_PORT=7437

# ── Logging ───────────────────────────────────────────────────
CPY_CLAUDE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
CPY_CLAUDE_LOG_FILE=~/.cpyClaude/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
CPY_CLAUDE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
CPY_CLAUDE_CONFIG=~/.cpyClaude/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# KAMA_LLM_MODEL=claude-sonnet-4-6
# KAMA_MAX_STEPS=20
